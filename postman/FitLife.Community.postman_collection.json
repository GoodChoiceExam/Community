{
  "info": {
    "name": "FitLife Community",
    "description": "Postman collection for the FitLife Community microservice. Use the jwtToken variable with a Bearer token from Identity.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5246" },
    { "key": "identityBaseUrl", "value": "http://localhost:5244" },
    { "key": "jwtToken", "value": "" },
    { "key": "communityId", "value": "" }
  ],
  "item": [
    {
      "name": "Public - Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/healthz"
      }
    },
    {
      "name": "Public - Swagger",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/swagger"
      }
    },
    {
      "name": "Identity - Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"member@example.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": "{{identityBaseUrl}}/auth/login"
      }
    },
    {
      "name": "Community - Get communities",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/communities"
      }
    },
    {
      "name": "Community - Create community",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{jwtToken}}", "type": "string" }
          ]
        },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"center\": \"Vesterbro\",\n  \"name\": \"Vesterbro Community\"\n}"
        },
        "url": "{{baseUrl}}/api/communities"
      }
    },
    {
      "name": "Community - Get posts",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/communities/{{communityId}}/posts"
      }
    },
    {
      "name": "Community - Create post",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{jwtToken}}", "type": "string" }
          ]
        },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Kommer nogen til hold i aften?\"\n}"
        },
        "url": "{{baseUrl}}/api/communities/{{communityId}}/posts"
      }
    },
    {
      "name": "Community - Recent activity",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/community/activity/recent"
      }
    }
  ]
}
